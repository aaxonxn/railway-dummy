# Environment configuration example for Railway Passenger Help Desk
# Copy this file to .env and configure your actual credentials

# Google Gemini API key (required for LLM answering, query synthesis, routing)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model identifier (optional, defaults to gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite

# Tesseract executable path (defaults to C:\Program Files\Tesseract-OCR\tesseract.exe on Windows)
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

